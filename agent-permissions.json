{
  "version": "1.0",
  "description": "Agent access permissions for Kynov",
  "interactions": {
    "read": {
      "allowed": true,
      "paths": [
        "/",
        "/compare/*",
        "/docs/*",
        "/terms",
        "/privacy",
        "/llms.txt",
        "/skill.md"
      ]
    },
    "api": {
      "allowed": true,
      "endpoints": [
        "/api/v1/*"
      ],
      "rateLimit": "100/minute"
    }
  },
  "rateLimits": {
    "default": "100/minute",
    "authenticated": "1000/minute"
  },
  "contact": "contact@harisarshad.site"
}
